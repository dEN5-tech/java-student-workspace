{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "⚡ Быстрый запуск Java файла (Ctrl+Shift+B)",
            "type": "shell",
            "command": "java",
            "args": [
                "-Dfile.encoding=UTF-8",
                "-Dsun.jnu.encoding=UTF-8",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
