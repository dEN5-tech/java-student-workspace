{
    "java.debug.settings.console": "integratedTerminal",
    "java.debug.settings.showHex": false,
    "java.autobuild.enabled": true,
    "java.help.firstView": "none",
    "java.showBuildStatusOnStart": "notification",
    "java.jdt.ls.vmargs": "-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8",
    "java.dependency.packagePresentation": "flat",
    "java.project.sourcePaths": [
        "src",
        "."
    ],
    "java.refactor.renameFromFile": true,
    "explorer.compactFolders": true,
    "files.encoding": "utf8",
    "files.autoGuessEncoding": true,
    "code-runner.runInTerminal": true,
    "code-runner.clearPreviousOutput": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.preserveFocus": false,
    "code-runner.ignoreSelection": true,
    "code-runner.executorMap": {
        "java": "cd $dir && java -Dfile.encoding=UTF-8 $fileName"
    },
    "terminal.integrated.scrollback": 5000,
    "terminal.integrated.env.linux": {
        "LANG": "ru_RU.UTF-8",
        "LC_ALL": "ru_RU.UTF-8",
        "JAVA_TOOL_OPTIONS": "-Dfile.encoding=UTF-8"
    },
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 1000,
    "editor.suggestSelection": "first",
    "editor.snippetSuggestions": "top",
    "editor.formatOnSave": true,
    "editor.bracketPairColorization.enabled": true,
    "editor.guides.bracketPairs": "active"
}
