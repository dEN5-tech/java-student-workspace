{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "▶ Запустить текущий файл (русский текст / ввод)",
            "request": "launch",
            "mainClass": "${file}",
            "console": "integratedTerminal",
            "vmArgs": "-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8",
            "stopOnEntry": false
        },
        {
            "type": "java",
            "name": "▶ Запустить Main.java",
            "request": "launch",
            "mainClass": "Main",
            "console": "integratedTerminal",
            "vmArgs": "-Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8"
        }
    ]
}
